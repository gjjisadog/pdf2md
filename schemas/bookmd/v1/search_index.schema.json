{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmd.local/schema/1.0/search_index.json",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "chapter_id", "chapter_path", "chapter_title", "type", "text"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "chapter_id": {"type": "string", "minLength": 1},
          "chapter_path": {"type": "string", "pattern": "^chapters/[^/].*\\.md$"},
          "chapter_title": {"type": "string"},
          "type": {"type": "string", "minLength": 1},
          "text": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

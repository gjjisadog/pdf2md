{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmd.local/schema/1.0/book.json",
  "type": "object",
  "required": ["format_version", "book_id", "title", "language", "chapters"],
  "properties": {
    "format_version": {"const": "1.0"},
    "book_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "author": {"type": "string"},
    "source_pdf": {"type": "string"},
    "language": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "version": {"type": "string"},
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "path", "order"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "path": {"type": "string", "pattern": "^chapters/[^/].*\\.md$"},
          "order": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

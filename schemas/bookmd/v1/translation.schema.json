{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmd.local/schema/1.0/translation.json",
  "type": "object",
  "required": ["provider", "model", "target_lang", "blocks"],
  "properties": {
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "target_lang": {"type": "string", "minLength": 1},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "source_text", "translated_text", "status"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "source_text": {"type": "string"},
          "translated_text": {"type": "string"},
          "provider": {"type": "string"},
          "model": {"type": "string"},
          "status": {"type": "string", "enum": ["source", "translated", "error", "pending"]},
          "cache_key": {"type": "string"},
          "error": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

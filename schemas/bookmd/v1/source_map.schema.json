{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookmd.local/schema/1.0/source_map.json",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["block_id", "chapter_id", "markdown_path", "source_page", "bbox", "source_text", "translated_text", "type"],
        "properties": {
          "block_id": {"type": "string", "minLength": 1},
          "chapter_id": {"type": "string", "minLength": 1},
          "markdown_path": {"type": "string", "pattern": "^chapters/[^/].*\\.md$"},
          "source_page": {"type": "integer", "minimum": 1},
          "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "source_text": {"type": "string"},
          "translated_text": {"type": "string"},
          "type": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
